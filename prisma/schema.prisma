generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             BigInt   @id @default(autoincrement())
  name           String
  slug           String?  @unique
  category       String
  price          Float
  description    String?
  materials      String?
  image          String
  stock          Int?     @default(10)
  featured       Int?     @default(1)
  isCustomOrder  Int?     @default(1) @map("is_custom_order")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("products")
}

model Order {
  id              BigInt      @id @default(autoincrement())
  orderNumber     String      @unique @map("order_number")
  customerName    String      @map("customer_name")
  customerEmail   String?     @map("customer_email")
  customerPhone   String      @map("customer_phone")
  shippingAddress String      @map("shipping_address")
  city            String?
  country         String?
  currency        String?     @default("GHS")
  totalAmount     Float       @map("total_amount")
  paymentMethod   String?     @default("WhatsApp Order") @map("payment_method")
  paymentStatus   String?     @default("Pending") @map("payment_status")
  orderStatus     String?     @default("New") @map("order_status")
  courierName     String?     @default("Accra Express Courier") @map("courier_name")
  trackingNumber  String?     @map("tracking_number")
  notes           String?
  createdAt       DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          BigInt  @id @default(autoincrement())
  orderId     BigInt  @map("order_id")
  productId   BigInt? @map("product_id")
  productName String  @map("product_name")
  price       Float
  quantity    Int
  subtotal    Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Setting {
  key   String  @id
  value String?

  @@map("settings")
}
