# Set one PostgreSQL URL key. Never commit a real database URL.
# DATABASE_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_PRISMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=replace-before-seeding
